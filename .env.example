# Environment variables for Resort & Restaurant Management System

# Database
# Production Neon connection string (pooled)
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct URL for Prisma migrations (non-pooled)
DIRECT_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication (jose JWT / session secret)
AUTH_SECRET="supersecret_min_32_chars_random_string_here"

# Vercel Blob (Images, Guest Webcam Photos, ID Documents)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_sample_token"

# Transactional Email (Resend)
RESEND_API_KEY="re_sample_key"
RESEND_FROM_EMAIL="reservations@yourresortdomain.com"

# Bot Protection (Cloudflare Turnstile)
TURNSTILE_SITE_KEY="0x4AAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAA..."

# Analytics
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# Payment Architecture
PAYMENT_PROVIDER="razorpay_or_stripe"
PAYMENT_SECRET_KEY="sec_sample_key"
PAYMENT_WEBHOOK_SECRET="whsec_sample_key"
